# --- Required: X (Twitter) API credentials ---
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# --- AI Provider selection ---
# Supported: openai, gemini
AI_PROVIDER=openai

# --- OpenAI settings (required if AI_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Optional image model (if empty, no image generation)
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Gemini settings (required if AI_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.0-flash

# --- Bot behavior ---
APP_NAME=Auditor AI
APP_URL=https://auditor-ai-git-main-lucys-projects-d362fb4f.vercel.app/
APP_TAGLINE=AI-powered auditing and insights for SaaS teams
TONE=helpful, credible, concise
TARGET_AUDIENCE=founders, indie hackers, and product teams
CTA=Try it free today
HASHTAGS=#SaaS #AI #Startup

# Number of previous tweets to include as anti-repetition context
HISTORY_WINDOW=25
# Local history file
HISTORY_FILE=tweet_history.json

# If true, do not post to X (prints generated tweet only)
DRY_RUN=true
# If true, try generating image and attach it
ENABLE_IMAGE=false

# Optional: timezone label used in prompt only
TIMEZONE=Asia/Kolkata
